# ============================================================
# FUNDEDWEALTH TERMINAL — ENVIRONMENT CONFIGURATION
# ============================================================

# --- Supabase (REQUIRED) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# --- Authentication (REQUIRED) ---
JWT_SECRET=your-256-bit-terminal-jwt-secret
JWT_EXPIRY=24h
SSO_SHARED_SECRET=your-256-bit-sso-shared-secret-same-as-dashboard

# --- FundedWealth Dashboard ---
FW_DASHBOARD_URL=https://fundedwealth.com

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=https://terminal.fundedwealth.com
ADMIN_SECRET=your-admin-secret-for-cron-triggers

# --- Broker Credentials (configure when broker adapter is ready) ---
